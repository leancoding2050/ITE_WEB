
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String      @id @default(uuid())
  username  String   @unique
  password  String
  phone     String?
  phoneVerified DateTime?
  name      String?
  role      UserRole
  teacherholidaysDateTime String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  accounts  Account[]
  sessions  Session[]
  Order     Order[]
  Cart      Cart[]
  CourseModul CourseModul[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model teacherholiday {
  id        String      @id @default(uuid())
  date      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model School {
  id        String      @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model company {
  id        String      @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Certigificate {
  id        String      @id @default(uuid())
  name       String
  date      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  GroupUser     GroupUser[]
  GroupMember   GroupMember[]
}

model GroupUser {
  id        String      @id @default(uuid())
  GroupName String
  Groupmember String[]
  Certificate Certigificate[]
  Course    Course[]
  Date      String[]
}

model GroupMember {
  id        String      @id @default(uuid())
  username  String
  Date      String[]
  Certificate Certigificate[]
  Course    Course[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id               String            @id @default(uuid())
  title            String
  description      String
  course_code      String
  school_name      String
  CourseTypes      String?
  start_date       String?
  end_date         String?
  Coursedates      String[]          @default([])
  Number_of_days   Int
  time_hours       Int
  TimeRange        String[]          @default([]) // 儲存可用的時間段（例如 ["morning", "afternoon"]）
  teacher          String[]          @default([])
  teacher_id       String
  Ispublic         Boolean
  Isproduct        Boolean
  type             String[]          @default([])
  classroom        String?           // 可選的課室欄位
  weekday          String?           // 可選的週份欄位
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  GroupUser        GroupUser[]
  GroupMember      GroupMember[]
  CourseModul      CourseModul?      @relation(fields: [courseModulId], references: [id])
  courseModulId    String?
  CoursePorductType CoursePorductType[]
  CoursePorductStatue CoursePorductStatue[]
  CourseTimeRanges CourseTimeRange[] // 新增關聯到 CourseTimeRange
  Products         Product[]         // 新增反向關聯
}

model CourseTimeRange {
  id          String   @id @default(uuid())
  courseId    String
  timeRange   String   // 例如 "morning", "afternoon", "evening", "full_day"
  start_time  String?  // 例如 "09:00"
  end_time    String?  // 例如 "13:00"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Product {
  id        String      @id @default(uuid())
  title      String
  description String
  price    Int
  CoursePorductTypeArray String[]
  CoursePorductStatueArray String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  IsPublic   Boolean
  courseId  String?    @map("course_id") // 新增課程關聯
  Course    Course?    @relation(fields: [courseId], references: [id])
  CartItem  CartItem[]
  OrderItem OrderItem[]
  CoursePorductType CoursePorductType[]
  CoursePorductStatue CoursePorductStatue[]
}

model CourseModul {
  id               String      @id @default(uuid())
  title            String
  description      String
  Teaching_Materials String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  TeacherId        String
  Teacher          User @relation(fields: [TeacherId], references: [id])
  Courses          Course[] // 反向關係，指向引用此 CourseModul 的所有 Course
}

model Message_Box {
  id        String      @id @default(uuid())
  title  String
  content String
  sender String
  receiver String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Accounts {
  id        String      @id @default(uuid())
  title  String
  description String
  price Int
  total Int
  date String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NITTP {
  id        String      @id @default(uuid())
  title   String
  description String
  school_name String
  day String
  time String
  time_h Int
  teacher String[]
  Ispublic     Boolean
  company_name String
  company_price Int
  date_start String
  date_end String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Homemade {
  id        String      @id @default(uuid())
  title  String
  description String
  teacher String[]
  Ispublic     Boolean
  Homemade_code String
  school_name String
  day String
  time String
  time_h Int
  date_start String
  date_end String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ERB {
  id        String      @id @default(uuid())
  ERB_code String
  title  String
  description String
  school_name String
  day String
  time String
  time_h Int
  teacher String[]
  Ispublic     Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cart {
  id        String      @id @default(uuid())
  userId    String
  createdAt   DateTime @default(now())
  updatedAt DateTime    @updatedAt
  items     CartItem[]
  user      User        @relation(fields: [userId], references: [id])
}

model CartItem {
  id        String      @id @default(uuid())
  cartId    String
  productId String
  quantity  Int
  createdAt  DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  cart      Cart        @relation(fields: [cartId], references: [id])
  product   Product     @relation(fields: [productId], references: [id])
}

model Order {
  id        String      @id @default(uuid())
  userId    String
  total     Float
  status    String      @default("PENDING")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  items     OrderItem[]
  user      User        @relation(fields: [userId], references: [id])
}

model OrderItem {
  id        String      @id @default(uuid())
  orderId  String
  productId String
  quantity  Int
  price     Float
  createdAt  DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  order     Order       @relation(fields: [orderId], references: [id])
  product   Product     @relation(fields: [productId], references: [id])
}

model CoursePorductType {
  id        String      @id @default(uuid())
  typename  String
  author    String
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Product  Product[]
  Course    Course[]
}

model CoursePorductStatue {
  id          String      @id @default(uuid())
  statuename  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Product  Product[]
  Course    Course[]
}

model HeaderType {
  id        String      @id @default(uuid())
  HeaderTypeName  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum UserRole {
  USER
  ADMIN
  TEACHER
}